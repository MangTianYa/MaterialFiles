<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <me.zhanghai.android.files.ui.CoordinatorAppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?colorAppBarSurface"
        android:theme="?actionBarTheme">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?actionBarSize"
            app:popupTheme="?actionBarPopupTheme" />
    </me.zhanghai.android.files.ui.CoordinatorAppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.4" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="256dp"
            android:layout_height="256dp"
            app:cardBackgroundColor="?colorSurfaceContainerHigh"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="?colorOutlineVariant"
            app:strokeWidth="1dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/placeholderIcon"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/audio_icon_white_24dp"
                    app:tint="?colorPrimary" />

                <ImageView
                    android:id="@+id/coverImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:ellipsize="marquee"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:textColor="?colorOnSurface"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/artistText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:gravity="center"
            android:singleLine="true"
            android:textColor="?colorOnSurfaceVariant"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/formatChipText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/pill_surface_container_bg"
            android:fontFeatureSettings="tnum"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:textColor="?colorOnSurfaceVariant"
            android:textSize="11.5sp"
            android:visibility="gone" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.6" />

        <com.google.android.material.slider.Slider
            android:id="@+id/progressSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/currentTimeText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFeatureSettings="tnum"
                android:text="@string/audio_player_zero_time"
                android:textColor="?colorOnSurfaceVariant"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/durationTimeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:text="@string/audio_player_zero_time"
                android:textColor="?colorOnSurfaceVariant"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <me.zhanghai.android.foregroundcompat.ForegroundImageButton
                android:id="@+id/repeatButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@null"
                android:contentDescription="@string/audio_player_repeat_mode"
                android:foreground="@drawable/selectable_item_background_oval"
                android:padding="12dp"
                android:src="@drawable/repeat_icon_white_24dp"
                app:tint="?colorOnSurfaceVariant" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <me.zhanghai.android.foregroundcompat.ForegroundImageButton
                android:id="@+id/previousButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@null"
                android:contentDescription="@string/audio_player_previous"
                android:foreground="@drawable/selectable_item_background_oval"
                android:padding="12dp"
                android:src="@drawable/skip_previous_icon_white_24dp"
                app:tint="?colorOnSurface" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/playPauseButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:contentDescription="@string/audio_player_play_pause"
                app:fabCustomSize="68dp"
                app:maxImageSize="32dp"
                app:srcCompat="@drawable/play_arrow_icon_white_24dp" />

            <me.zhanghai.android.foregroundcompat.ForegroundImageButton
                android:id="@+id/nextButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@null"
                android:contentDescription="@string/audio_player_next"
                android:foreground="@drawable/selectable_item_background_oval"
                android:padding="12dp"
                android:src="@drawable/skip_next_icon_white_24dp"
                app:tint="?colorOnSurface" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <me.zhanghai.android.foregroundcompat.ForegroundImageButton
                android:id="@+id/playlistButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@null"
                android:contentDescription="@string/audio_player_playlist"
                android:foreground="@drawable/selectable_item_background_oval"
                android:padding="12dp"
                android:src="@drawable/queue_music_icon_white_24dp"
                app:tint="?colorOnSurfaceVariant" />
        </LinearLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
