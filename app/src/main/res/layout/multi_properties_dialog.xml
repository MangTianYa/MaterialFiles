<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="?dialogPreferredPadding"
    android:paddingEnd="?dialogPreferredPadding"
    android:paddingTop="8dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/multi_properties_selected_label"
            android:textColor="?colorOnSurfaceVariant"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/selectedValueText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp"
            android:textColor="?colorOnSurface"
            android:textIsSelectable="true"
            android:textSize="14.5sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/multi_properties_location_label"
            android:textColor="?colorOnSurfaceVariant"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/locationValueText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp"
            android:textColor="?colorOnSurface"
            android:textIsSelectable="true"
            android:textSize="14.5sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/multi_properties_contents_label"
            android:textColor="?colorOnSurfaceVariant"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/contentsValueText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp"
            android:textColor="?colorOnSurface"
            android:textIsSelectable="true"
            android:textSize="14.5sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/multi_properties_total_size_label"
            android:textColor="?colorOnSurfaceVariant"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/sizeValueText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp"
            android:textColor="?colorOnSurface"
            android:textIsSelectable="true"
            android:textSize="14.5sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/multi_properties_modified_label"
            android:textColor="?colorOnSurfaceVariant"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/modifiedValueText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp"
            android:textColor="?colorOnSurface"
            android:textIsSelectable="true"
            android:textSize="14.5sp" />
    </LinearLayout>
</ScrollView>
