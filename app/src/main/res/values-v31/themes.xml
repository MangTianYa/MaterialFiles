<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Platform.Theme.MaterialFiles.Dynamic" parent="Theme.Material3.DynamicColors.DayNight.NoActionBar">
        <item name="android:navigationBarColor">?colorPrimaryDark</item>
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
        <item name="android:windowLightStatusBar">?isLightTheme</item>
        <item name="android:windowLightNavigationBar">?isLightTheme</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="colorPrimaryDark">@android:color/transparent</item>
    </style>

    <style name="Platform.Theme.MaterialFiles.Immersive.Dynamic" parent="Theme.Material3.DynamicColors.Dark.NoActionBar">
        <item name="android:navigationBarColor">?colorPrimaryDark</item>
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="colorPrimaryDark">@android:color/transparent</item>
    </style>
</resources>
